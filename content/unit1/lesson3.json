        {
          "type": "info-box",
          "title": "Structures à observer",
          "sections": [
            {
              "heading": "Exprimer l’utilité / l’avantage",
              "items": [
                "Structure : Il permet de + infinitif",
                "Exemple : Il permet de rouler moins cher et de réduire la pollution."
              ]
            },
            {
              "heading": "Exprimer la négation",
              "items": [
                "Structure : ne … pas",
                "Exemple : Ce n’est pas un service de transport professionnel."
              ]
            },
            {
              "heading": "Exprimer l’opposition / la concession",
              "items": [
                "Expressions : mais / pourtant / malgré",
                "Exemple : Mais il ne faut pas oublier les petits inconvénients.",
                "Exemple : Malgré ces petits problèmes, le covoiturage reste une solution responsable."
              ]
            },
            {
              "heading": "Exprimer la conséquence",
              "items": [
                "Structure : ce qui + verbe",
                "Exemple : Ce qui prouve que cette habitude entre dans le quotidien des Français."
              ]
            }
          ]
        }
