      "content": [
        {
          "type": "heading",
          "text": "Leçon 2 : Les espaces verts",
          "level": 1
        },
        {
          "type": "divider"
        },
        {
          "type": "heading",
          "text": "Objectifs de cette leçon :",
          "level": 2
        },
        {
          "type": "paragraph",
          "text": "À la fin de la leçon « les espaces verts », l’apprenant sera capable de comprendre un texte explicatif et de produire un texte écrit cohérent et structuré pour informer et convaincre."
        },
        {
          "type": "objectives",
          "title": "Objectifs de la leçon (01 - 12)",
          "items": [
            {
              "num": "01",
              "text": "Comprendre l’idée générale et déterminer les idées principales et secondaires d’un texte lu."
            },
            {
              "num": "02",
              "text": "Saisir le sens des mots selon le contexte."
            },
            {
              "num": "03",
              "text": "Etablir des liens entre les parties d’un texte lu."
            },
            {
              "num": "04",
              "text": "Suivre l’enchaînement chronologique des événements d’un texte lu."
            },
            {
              "num": "05",
              "text": "Résumer correctement un texte lu."
            },
            {
              "num": "06",
              "text": "Employer des mots adéquats à la situation."
            },
            {
              "num": "07",
              "text": "Écrire des phrases correctes et cohérentes."
            },
            {
              "num": "08",
              "text": "Employer les connecteurs logiques."
            },
            {
              "num": "09",
              "text": "Fonctionner les règles de présentation du texte (introduction-développement - conclusion)."
            },
            {
              "num": "10",
              "text": "Réviser et améliorer son texte à partir des remarques ou en comparant avec les camarades."
            },
            {
              "num": "11",
              "text": "Amener les apprenants à comprendre l’importance de l’apprentissage du français pour leur avenir académique et professionnel."
            },
            {
              "num": "12",
              "text": "Renforcer l’engagement des apprenants dans les activités d’apprentissage afin de susciter leur intérêt pour l’apprentissage du FLE."
            }
          ]
        }
      ]
    },
